# PetBook local environment
# Copy to .env and replace the secrets before exposing this stack.

# PostgreSQL
POSTGRES_DB=petbook
POSTGRES_USER=petbook
POSTGRES_PASSWORD=petbook

# Directus
DIRECTUS_KEY=replace-with-32-byte-random-hex
DIRECTUS_SECRET=replace-with-32-byte-random-hex
DIRECTUS_PUBLIC_URL=http://localhost:8055
ADMIN_EMAIL=admin@petbook.io
ADMIN_PASSWORD=PetBook123!

# Web
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-32-byte-random-hex
COMMISSION_RATE=10
LOYALTY_POINTS_PER_HUNDRED=2
LOYALTY_POINT_VALUE=0.5
CRON_SECRET=dev-cron-secret

# Payments: set PAYMENT_PROVIDER=paymongo and add keys for online checkout.
PAYMENT_PROVIDER=mock
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=dev-paymongo-webhook-secret
PAYMONGO_PAYMENT_METHODS=gcash,maya,grab_pay,qrph,card

# Notifications (mock writes to the notifications collection)
SMS_PROVIDER=mock
# Email: codes are delivered only to the user's inbox, never shown in the app.
# Set EMAIL_PROVIDER=resend and add RESEND_API_KEY for real delivery.
EMAIL_PROVIDER=resend
EMAIL_FROM=PetBook <no-reply@petbook.local>
RESEND_API_KEY=
EMAIL_REQUIRE_MX=true

# Directus transactional email (password reset).
# Use smtp with Resend/another provider in production; sendmail requires a local MTA.
# Registration OTP emails are sent by the web app using EMAIL_PROVIDER/RESEND_API_KEY above.
EMAIL_TRANSPORT=sendmail
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Directus Google OAuth. Fill every value before setting AUTH_PROVIDERS=google.
# Then set NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true so the login button appears.
AUTH_PROVIDERS=
AUTH_GOOGLE_DRIVER=openid
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ISSUER_URL=https://accounts.google.com
AUTH_GOOGLE_IDENTIFIER_KEY=email
AUTH_GOOGLE_ALLOW_PUBLIC_REGISTRATION=true
AUTH_GOOGLE_REQUIRE_VERIFIED_EMAIL=true
AUTH_GOOGLE_DEFAULT_ROLE_ID=
AUTH_GOOGLE_MODE=json
AUTH_GOOGLE_REDIRECT_ALLOW_LIST=
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false

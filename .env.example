# PetBook local environment
# Copy to .env and replace the secrets before exposing this stack.

# PostgreSQL
POSTGRES_DB=petbook
POSTGRES_USER=petbook
POSTGRES_PASSWORD=petbook

# Directus
DIRECTUS_KEY=replace-with-32-byte-random-hex
DIRECTUS_SECRET=replace-with-32-byte-random-hex
DIRECTUS_PUBLIC_URL=http://localhost:8055
ADMIN_EMAIL=admin@petbook.io
ADMIN_PASSWORD=PetBook123!

# Web
APP_URL=http://localhost:3000
COMMISSION_RATE=10
LOYALTY_POINTS_PER_HUNDRED=2
LOYALTY_POINT_VALUE=0.5
CRON_SECRET=dev-cron-secret

# Payments: set PAYMENT_PROVIDER=paymongo and add keys for online checkout.
PAYMENT_PROVIDER=mock
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=dev-paymongo-webhook-secret
PAYMONGO_PAYMENT_METHODS=gcash,maya,grab_pay,qrph,card

# Notifications (mock writes to the notifications collection)
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock

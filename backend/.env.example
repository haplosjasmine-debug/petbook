APP_NAME=PetBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=petbook
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@petbook.io"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ------------------------------------------------------------------
# PetBook application settings
# ------------------------------------------------------------------
PETBOOK_COMMISSION_RATE=0.10
PETBOOK_LOYALTY_POINTS_PER_UNIT=1
PETBOOK_REMINDER_LEAD_HOURS=24
PETBOOK_FOLLOWUP_DAYS=3
PETBOOK_PACKAGE_EXPIRY_WARNING_DAYS=14

# ------------------------------------------------------------------
# Directus CMS (shared MySQL database)
# ------------------------------------------------------------------
DIRECTUS_ENABLED=true
DIRECTUS_URL=http://localhost:8055
DIRECTUS_ADMIN_EMAIL=admin@petbook.io
DIRECTUS_ADMIN_PASSWORD=ChangeMe123!
DIRECTUS_WEBHOOK_SECRET=change-me

# ------------------------------------------------------------------
# SMS reminders
# ------------------------------------------------------------------
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ------------------------------------------------------------------
# Online payments (Philippines) - PayMongo: GCash, Maya, GrabPay, QR Ph, cards
# Get keys at https://dashboard.paymongo.com/developers
# ------------------------------------------------------------------
PAYMENT_PROVIDER=paymongo
PAYMENT_CURRENCY=PHP
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=change-me
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_PAYMENT_METHODS=gcash,maya,grab_pay,qrph,card
PAYMENT_SUCCESS_URL=https://your-cms.example.com/admin/content/transactions?payment=success
PAYMENT_CANCEL_URL=https://your-cms.example.com/admin/content/transactions?payment=cancelled

# Secret required by the scheduled reminder processing endpoint
CRON_SECRET=change-me

SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost:8055
SESSION_DOMAIN=localhost

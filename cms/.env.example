########################################################
# PetBook Directus CMS - environment template
########################################################

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY=
SECRET=

ADMIN_EMAIL=admin@petbook.io
ADMIN_PASSWORD=ChangeMe123!

# Shared MySQL database (owned by Laravel migrations)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=petbook
DB_USER=root
DB_PASSWORD=

HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://localhost:8055
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:8000,http://localhost:3000
RATE_LIMITER_ENABLED=false
TELEMETRY=false

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

# PetBook integration (used by scripts/setup.mjs)
PETBOOK_API_URL=http://localhost:8000
PETBOOK_WEBHOOK_SECRET=dev-directus-webhook-secret


# Run the web app against a locally started Directus.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DIRECTUS_URL=http://127.0.0.1:8055
DIRECTUS_URL=http://127.0.0.1:8055
DIRECTUS_ADMIN_EMAIL=admin@petbook.io
DIRECTUS_ADMIN_PASSWORD=PetBook123!
AUTH_SECRET=replace-with-32-byte-random-hex

COMMISSION_RATE=10
LOYALTY_POINTS_PER_HUNDRED=2
LOYALTY_POINT_VALUE=0.5
CRON_SECRET=dev-cron-secret

PAYMENT_PROVIDER=mock
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=dev-paymongo-webhook-secret
PAYMONGO_PAYMENT_METHODS=gcash,maya,grab_pay,qrph,card

SMS_PROVIDER=mock
# Login alert SMS: set SMS_PROVIDER=twilio or semaphore and fill the matching keys.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=PetBook
# Email: registration and password reset codes are delivered only to the user's inbox.
# Set EMAIL_PROVIDER=resend and add RESEND_API_KEY; codes are never shown in the app.
# Directus sends password reset emails using EMAIL_TRANSPORT/EMAIL_SMTP_* instead.
EMAIL_PROVIDER=resend
EMAIL_FROM=PetBook <no-reply@petbook.local>
RESEND_API_KEY=
EMAIL_REQUIRE_MX=true

# Show "Continue with Google" only after Directus Google OAuth is configured.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
